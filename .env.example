# Public origin, used for canonical URLs, hreflang pairs and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://runvo.io

# Where waitlist signups go. Set one or both; with neither, signups only log.
# Any endpoint that accepts a JSON POST (Zapier, Make, n8n, Slack incoming webhook).
WAITLIST_WEBHOOK_URL=
# Email per signup via Resend's HTTP API — no SDK needed.
RESEND_API_KEY=
WAITLIST_NOTIFY_EMAIL=
WAITLIST_FROM_EMAIL="Runvo <waitlist@runvo.io>"
